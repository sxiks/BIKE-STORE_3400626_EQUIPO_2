# Contraseñas de la base de datos local de Docker (docker-compose.yml).
# Copia este archivo como .env en la raíz del repositorio: cp .env.example .env
# El .env NO se sube a GitHub. Cada PC elige sus propias contraseñas.
#
# Solo se usan la PRIMERA vez que se crea la base (o después de docker compose down -v).
# Para cambiarlas en una base que ya existe: docs/GUIA_EJECUCION_LOCAL.md, paso 4.

# Superusuario interno de PostgreSQL. Obligatoria: escribe una contraseña propia.
POSTGRES_PASSWORD=

# Rol de la aplicación (bike_store_app). Debe ser igual a DB_PASSWORD de backend/.env
# y backend/.env.test. Si la cambias aquí, cámbiala también allí.
DB_PASSWORD=cambia_esta_clave
