# ============================================================
# Bike Store · .gitignore único del monorepo (reemplaza los 3
# .gitignore que traían los proyectos de origen)
# ============================================================

# Dependencias
node_modules/

# Variables de entorno: NUNCA se suben. Solo los .env.example
.env
.env.*
!.env.example

# Archivos subidos por usuarios (se crean solos al arrancar el backend)
backend/uploads/

# Builds y cobertura
dist/
build/
coverage/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporales
tmp/
temp/
*.tmp
*.pid

# Editores e IDEs (cada quien configura el suyo)
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db

# NOTA: package-lock.json SÍ se versiona (ver CONTRIBUTING.md §6).
