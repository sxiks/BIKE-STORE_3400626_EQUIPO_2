# Configuración de las PRUEBAS AUTOMATIZADAS (npm test).
# Copia este archivo como .env.test (no se sube a GitHub) y ajusta DB_PASSWORD.
# Las pruebas BORRAN los datos de esta base: DB_NAME debe terminar en _test.
# La base se crea una sola vez por PC (ver backend/README.md, sección "Pruebas").

NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bike_store_test
DB_USER=bike_store_app
DB_PASSWORD=cambia_esta_clave
DB_TIMEZONE=America/Bogota

JWT_SECRET=secreto_solo_para_pruebas_automatizadas_no_usar_en_produccion
JWT_EXPIRES_IN=2h

# Vacíos a propósito: las pruebas crean sus propios usuarios.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

STOCK_BAJO_UMBRAL=5
RESET_TOKEN_MINUTOS=30
# true: las pruebas leen el token de recuperación desde la respuesta (solo con NODE_ENV=development).
RESET_TOKEN_EN_RESPUESTA=true
