# Ambiente: development | production
NODE_ENV=development
PORT=3000

# PostgreSQL 15+. Con Docker (docs/GUIA_EJECUCION_LOCAL.md, paso 4) el rol y la base ya existen
# y la base escucha en el puerto 5433. Con PostgreSQL instalado sin Docker, usa 5432.
# Con Docker, DB_PASSWORD debe ser igual a DB_PASSWORD del .env de la raíz del repositorio.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=bike_store
DB_USER=bike_store_app
DB_PASSWORD=cambia_esta_clave
DB_TIMEZONE=America/Bogota

# JWT - usa una cadena larga y aleatoria en tu .env real
JWT_SECRET=cambia_este_secreto_por_uno_largo
JWT_EXPIRES_IN=2h

# Origen permitido por CORS (el frontend de Vite)
CORS_ORIGIN=http://localhost:5173

# Admin inicial: se crea al arrancar si no existe. La clave debe cumplir D7
# (mínimo 8 caracteres, con mayúscula, minúscula y número).
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@bikestore.local
ADMIN_PASSWORD=CambiaEsta123

# Tablero: existencias iguales o menores a este valor generan alerta de stock bajo
STOCK_BAJO_UMBRAL=5

# Recuperación de contraseña (CU-11)
RESET_TOKEN_MINUTOS=30
# true = además de la consola, el token vuelve en la respuesta de POST /api/auth/recuperar
# Solo funciona con NODE_ENV=development. En producción se ignora.
RESET_TOKEN_EN_RESPUESTA=true
